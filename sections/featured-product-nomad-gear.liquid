{% assign venture_product = section.settings.product %}

<section
  class="venture-product color-{{ section.settings.color_scheme }}"
  {% if section.settings.section_id != blank %}
    id="{{ section.settings.section_id | handleize }}"
  {% endif %}
>
  <div class="venture-product__container">

    {% if venture_product != blank %}

      <div class="venture-product__card">

        {%- comment -%}
          Product image
        {%- endcomment -%}
        <div class="venture-product__media">
          {% if venture_product.featured_image != blank %}

            {{
              venture_product.featured_image
              | image_url: width: 1600
              | image_tag:
                class: 'venture-product__image',
                loading: 'lazy',
                widths: '400, 600, 800, 1000, 1200, 1400, 1600',
                sizes: '(min-width: 990px) 50vw, 100vw',
                alt: venture_product.featured_image.alt | default: venture_product.title
            }}

          {% else %}

            <div class="venture-product__placeholder">
              <span>{{ venture_product.title }}</span>
            </div>

          {% endif %}
        </div>


        {%- comment -%}
          Product content
        {%- endcomment -%}
        <div class="venture-product__content">
          <div class="venture-product__content-inner">

            {% if section.settings.eyebrow != blank %}
              <p class="venture-product__eyebrow">
                {{ section.settings.eyebrow }}
              </p>
            {% endif %}


            {%- comment -%}
              Heading
              If custom heading is empty, product title is used.
            {%- endcomment -%}
            {% if section.settings.heading != blank %}

              <h2 class="venture-product__heading">
                {{ section.settings.heading }}
              </h2>

            {% else %}

              <h2 class="venture-product__heading">
                {{ venture_product.title }}
              </h2>

            {% endif %}


            {%- comment -%}
              Description
            {%- endcomment -%}
            {% if section.settings.use_product_description %}

              {% if venture_product.description != blank %}
                <div class="venture-product__description">
                  {{ venture_product.description }}
                </div>
              {% endif %}

            {% elsif section.settings.custom_description != blank %}

              <div class="venture-product__description">
                {{ section.settings.custom_description }}
              </div>

            {% endif %}


            {%- comment -%}
              Product attributes
            {%- endcomment -%}
            {% if section.blocks.size > 0 %}

              <div class="venture-product__attributes">

                {% for block in section.blocks %}

                  {% case block.type %}

                    {% when 'attribute' %}

                      <div
                        class="venture-product__attribute"
                        {{ block.shopify_attributes }}
                      >

                        {% if block.settings.label != blank %}
                          <p class="venture-product__attribute-label">
                            {{ block.settings.label }}
                          </p>
                        {% endif %}

                        {% if block.settings.value != blank %}
                          <p class="venture-product__attribute-value">
                            {{ block.settings.value }}
                          </p>
                        {% endif %}

                      </div>

                  {% endcase %}

                {% endfor %}

              </div>

            {% endif %}


            {%- comment -%}
              CTA + price
            {%- endcomment -%}
            <div class="venture-product__footer">

              {% if section.settings.button_label != blank %}

                <a
                  href="{{ venture_product.url }}"
                  class="venture-product__button"
                  aria-label="{{ section.settings.button_label | escape }} - {{ venture_product.title | escape }}"
                >
                  {{ section.settings.button_label }}
                </a>

              {% endif %}


              <div class="venture-product__price">

                {% if venture_product.compare_at_price > venture_product.price %}

                  <span class="venture-product__price-current">
                    {{ venture_product.price | money }}
                  </span>

                  <s class="venture-product__price-compare">
                    {{ venture_product.compare_at_price | money }}
                  </s>

                {% else %}

                  <span class="venture-product__price-current">
                    {{ venture_product.price | money }}
                  </span>

                {% endif %}

              </div>

            </div>

          </div>
        </div>

      </div>

    {% else %}

      {%- comment -%}
        Empty state in Theme Editor
      {%- endcomment -%}
      <div class="venture-product__empty">

        <div class="venture-product__empty-content">

          <p class="venture-product__empty-title">
            Select a product
          </p>

          <p class="venture-product__empty-text">
            Choose a product from the section settings to display it here.
          </p>

        </div>

      </div>

    {% endif %}

  </div>
</section>


{% stylesheet %}

/*
|--------------------------------------------------------------------------
| Venture Product
|--------------------------------------------------------------------------
| Uses Shopify theme color scheme variables.
|
| Main variables:
| --color-background
| --color-foreground
| --color-button
| --color-button-text
|
*/


/*
|--------------------------------------------------------------------------
| Section
|--------------------------------------------------------------------------
*/

.venture-product {
  /*
   * Shopify color scheme variables are RGB values
   * in themes such as Dawn.
   */
  background-color: rgb(var(--color-background));
  color: rgb(var(--color-foreground));

  padding: 80px 24px;
}

.venture-product__container {
  width: 100%;
  max-width: 1280px;
  margin: 0 auto;
}


/*
|--------------------------------------------------------------------------
| Card
|--------------------------------------------------------------------------
*/

.venture-product__card {
  display: grid;
  width: 100%;
  overflow: hidden;

  /*
   * Slightly different background from the section
   * while still following the Shopify color scheme.
   */
  background-color: rgb(var(--color-background));

  border: 1px solid rgba(var(--color-foreground), 0.08);
  border-radius: 24px;
}


/*
|--------------------------------------------------------------------------
| Media
|--------------------------------------------------------------------------
*/

.venture-product__media {
  position: relative;

  min-height: 500px;

  /*
   * Uses foreground color at very low opacity
   * instead of a hardcoded background color.
   */
  background-color: rgba(var(--color-foreground), 0.04);
}

.venture-product__image {
  display: block;

  width: 100%;
  height: 100%;

  object-fit: cover;
  object-position: center;
}

.venture-product__placeholder {
  display: flex;
  align-items: center;
  justify-content: center;

  width: 100%;
  height: 100%;
  min-height: 500px;

  padding: 40px;

  color: rgba(var(--color-foreground), 0.5);

  font-size: 14px;
  font-weight: 600;
  line-height: 1.5;
  letter-spacing: 0.2em;
  text-align: center;
  text-transform: uppercase;
}


/*
|--------------------------------------------------------------------------
| Content
|--------------------------------------------------------------------------
*/

.venture-product__content {
  display: flex;
  align-items: center;

  padding: 64px 32px;
}

.venture-product__content-inner {
  width: 100%;
  max-width: 512px;
  margin: 0 auto;
}


/*
|--------------------------------------------------------------------------
| Eyebrow
|--------------------------------------------------------------------------
*/

.venture-product__eyebrow {
  margin: 0;

  color: rgba(var(--color-foreground), 0.45);

  font-size: 12px;
  font-weight: 600;
  line-height: 1.4;
  letter-spacing: 0.25em;
  text-transform: uppercase;
}


/*
|--------------------------------------------------------------------------
| Heading
|--------------------------------------------------------------------------
*/

.venture-product__heading {
  margin: 20px 0 0;

  color: rgb(var(--color-foreground));

  font-size: 36px;
  font-weight: 600;
  line-height: 1.1;
  letter-spacing: -0.025em;
}


/*
|--------------------------------------------------------------------------
| Description
|--------------------------------------------------------------------------
*/

.venture-product__description {
  margin-top: 24px;

  color: rgba(var(--color-foreground), 0.68);

  font-size: 16px;
  line-height: 1.75;
}

.venture-product__description > *:first-child {
  margin-top: 0;
}

.venture-product__description > *:last-child {
  margin-bottom: 0;
}

.venture-product__description p {
  margin: 0 0 1em;
}

.venture-product__description ul,
.venture-product__description ol {
  margin: 0 0 1em;
  padding-left: 20px;
}

.venture-product__description a {
  color: inherit;
  text-decoration: underline;
  text-underline-offset: 3px;
}


/*
|--------------------------------------------------------------------------
| Attributes
|--------------------------------------------------------------------------
*/

.venture-product__attributes {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));

  gap: 16px;

  margin-top: 32px;
  padding: 24px 0;

  border-top: 1px solid rgba(var(--color-foreground), 0.1);
  border-bottom: 1px solid rgba(var(--color-foreground), 0.1);
}

.venture-product__attribute {
  min-width: 0;
}

.venture-product__attribute-label {
  margin: 0;

  color: rgba(var(--color-foreground), 0.45);

  font-size: 12px;
  font-weight: 400;
  line-height: 1.4;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.venture-product__attribute-value {
  margin: 4px 0 0;

  color: rgb(var(--color-foreground));

  font-size: 14px;
  font-weight: 500;
  line-height: 1.5;
}


/*
|--------------------------------------------------------------------------
| Footer
|--------------------------------------------------------------------------
*/

.venture-product__footer {
  display: flex;
  align-items: center;

  gap: 20px;

  margin-top: 32px;
}


/*
|--------------------------------------------------------------------------
| Button
|--------------------------------------------------------------------------
|
| Shopify theme button colors:
| --color-button
| --color-button-text
|
*/

.venture-product__button {
  display: inline-flex;
  align-items: center;
  justify-content: center;

  min-height: 48px;

  padding: 14px 28px;

  border: 1px solid rgb(var(--color-button));

  background-color: rgb(var(--color-button));
  color: rgb(var(--color-button-text));

  font-size: 14px;
  font-weight: 600;
  line-height: 1.4;
  text-align: center;
  text-decoration: none;

  cursor: pointer;

  transition:
    background-color 180ms ease,
    color 180ms ease,
    border-color 180ms ease,
    opacity 180ms ease,
    transform 180ms ease;
}

.venture-product__button:hover {
  opacity: 0.88;
}

.venture-product__button:active {
  transform: translateY(1px);
}

.venture-product__button:focus-visible {
  outline: 2px solid rgb(var(--color-foreground));
  outline-offset: 3px;
}


/*
|--------------------------------------------------------------------------
| Price
|--------------------------------------------------------------------------
*/

.venture-product__price {
  display: inline-flex;
  align-items: center;
  flex-wrap: wrap;

  gap: 8px;

  color: rgba(var(--color-foreground), 0.6);

  font-size: 14px;
  line-height: 1.5;
}

.venture-product__price-current {
  color: rgb(var(--color-foreground));
}

.venture-product__price-compare {
  color: rgba(var(--color-foreground), 0.35);
}


/*
|--------------------------------------------------------------------------
| Empty State
|--------------------------------------------------------------------------
*/

.venture-product__empty {
  display: flex;
  align-items: center;
  justify-content: center;

  min-height: 320px;

  padding: 40px;

  border: 1px dashed rgba(var(--color-foreground), 0.25);
  border-radius: 24px;

  background-color: rgba(var(--color-foreground), 0.03);

  text-align: center;
}

.venture-product__empty-content {
  width: 100%;
  max-width: 420px;
}

.venture-product__empty-title {
  margin: 0;

  color: rgb(var(--color-foreground));

  font-size: 20px;
  font-weight: 600;
}

.venture-product__empty-text {
  margin: 8px 0 0;

  color: rgba(var(--color-foreground), 0.55);

  font-size: 14px;
  line-height: 1.6;
}


/*
|--------------------------------------------------------------------------
| Tablet
|--------------------------------------------------------------------------
*/

@media screen and (min-width: 750px) {

  .venture-product__content {
    padding: 64px 48px;
  }

  .venture-product__heading {
    font-size: 48px;
  }

}


/*
|--------------------------------------------------------------------------
| Desktop
|--------------------------------------------------------------------------
*/

@media screen and (min-width: 990px) {

  .venture-product__card {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .venture-product__content {
    padding: 64px;
  }

}


/*
|--------------------------------------------------------------------------
| Mobile
|--------------------------------------------------------------------------
*/

@media screen and (max-width: 749px) {

  .venture-product {
    padding: 64px 20px;
  }

  .venture-product__card {
    border-radius: 20px;
  }

  .venture-product__media,
  .venture-product__placeholder {
    min-height: 400px;
  }

  .venture-product__content {
    padding: 48px 24px;
  }

  .venture-product__heading {
    font-size: 34px;
  }

  .venture-product__footer {
    align-items: flex-start;
    flex-direction: column;

    gap: 14px;
  }

}


/*
|--------------------------------------------------------------------------
| Reduced Motion
|--------------------------------------------------------------------------
*/

@media (prefers-reduced-motion: reduce) {

  .venture-product__button {
    transition: none;
  }

}

{% endstylesheet %}


{% schema %}
{
  "name": "Venture Product",
  "tag": "section",
  "class": "venture-product-section",

  "settings": [

    {
      "type": "product",
      "id": "product",
      "label": "Product"
    },

    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },

    {
      "type": "text",
      "id": "section_id",
      "label": "Section ID",
      "info": "Optional. Used for anchor links."
    },

    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The foundation"
    },

    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Leave blank to automatically use the product title."
    },

    {
      "type": "checkbox",
      "id": "use_product_description",
      "label": "Use product description",
      "default": true
    },

    {
      "type": "richtext",
      "id": "custom_description",
      "label": "Custom description",
      "info": "Used when product description is disabled.",
      "default": "<p>Built for longer escapes and heavier loads without making your journey feel heavier. A dependable carry for outdoor adventures and multi-day trips.</p>"
    },

    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "View product"
    }

  ],

  "blocks": [

    {
      "type": "attribute",
      "name": "Attribute",

      "settings": [

        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Capacity"
        },

        {
          "type": "text",
          "id": "value",
          "label": "Value",
          "default": "45L"
        }

      ]
    }

  ],

  "presets": [

    {
      "name": "Venture Product",

      "blocks": [

        {
          "type": "attribute",
          "settings": {
            "label": "Capacity",
            "value": "45L"
          }
        },

        {
          "type": "attribute",
          "settings": {
            "label": "Trip duration",
            "value": "Multi-day"
          }
        },

        {
          "type": "attribute",
          "settings": {
            "label": "Carry",
            "value": "Comfortable"
          }
        },

        {
          "type": "attribute",
          "settings": {
            "label": "Warranty",
            "value": "Included"
          }
        }

      ]
    }

  ]

}
{% endschema %}
