{% comment %}
  ============================================================
  SOLUTION SECTION
  ============================================================
{% endcomment %}

<section
  id="shopify-section-{{ section.id }}"
  class="solution-section color-{{ section.settings.color_scheme }}"
>
  <div class="solution-section__inner">

    {% if section.settings.heading != blank %}
      <div class="solution-section__header">
        <h2 class="solution-section__heading">
          {{ section.settings.heading | escape }}
        </h2>
      </div>
    {% endif %}


    {% if section.blocks.size > 0 %}
      <div class="solution-section__grid">

        {% for block in section.blocks %}

          <article
            class="solution-card"
            {{ block.shopify_attributes }}
          >

            {% comment %}
              ==========================
              IMAGE
              ==========================
            {% endcomment %}

            {% if block.settings.image != blank %}

              <div class="solution-card__media">

                {{
                  block.settings.image
                  | image_url: width: 1600
                  | image_tag:
                    loading: 'lazy',
                    widths: '375, 550, 750, 1100, 1500, 1600',
                    sizes: '(min-width: 990px) calc((100vw - 120px) / 3), (min-width: 750px) calc((100vw - 60px) / 2), calc(100vw - 32px)',
                    class: 'solution-card__image',
                    alt: block.settings.image.alt | default: block.settings.title
                }}

              </div>

            {% else %}

              <div class="solution-card__media solution-card__media--placeholder">
                {{ 'image' | placeholder_svg_tag: 'solution-card__placeholder' }}
              </div>

            {% endif %}


            {% comment %}
              ==========================
              GRADIENT OVERLAY
              ==========================
            {% endcomment %}

            <div class="solution-card__overlay"></div>


            {% comment %}
              ==========================
              CONTENT
              ==========================
            {% endcomment %}

            <div class="solution-card__content">

              {% if block.settings.title != blank %}

                <h3 class="solution-card__title">
                  {{ block.settings.title | escape }}
                </h3>

              {% endif %}


              {% if block.settings.description != blank %}

                <div class="solution-card__description">
                  {{ block.settings.description }}
                </div>

              {% endif %}

            </div>

          </article>

        {% endfor %}

      </div>
    {% endif %}

  </div>
</section>


<style>

  /* ==========================================================
     SECTION VARIABLES
     ========================================================== */

  #shopify-section-{{ section.id }} {

    --solution-radius:
      {{ section.settings.card_radius }}px;

    --solution-gap:
      {{ section.settings.card_gap }}px;

    --solution-overlay-opacity:
      {{ section.settings.overlay_opacity | divided_by: 100.0 }};

  }


  /* ==========================================================
     SECTION
     ========================================================== */

  #shopify-section-{{ section.id }} .solution-section {

    width: 100%;

    background-color:
      rgb(var(--color-background));

    color:
      rgb(var(--color-foreground));

  }


  /* ==========================================================
     INNER CONTAINER
     ========================================================== */

  #shopify-section-{{ section.id }} .solution-section__inner {

    width: 100%;

    max-width:
      {{ section.settings.max_width }}px;

    margin: 0 auto;

    padding-top:
      {{ section.settings.padding_top }}px;

    padding-right: 24px;

    padding-bottom:
      {{ section.settings.padding_bottom }}px;

    padding-left: 24px;

  }


  /* ==========================================================
     HEADER
     ========================================================== */

  #shopify-section-{{ section.id }} .solution-section__header {

    max-width: 760px;

    margin-bottom: 32px;

  }


  #shopify-section-{{ section.id }} .solution-section__heading {

    margin: 0;

    color:
      rgb(var(--color-foreground));

    font-size: 42px;

    line-height: 1.12;

    letter-spacing: -0.025em;

    font-weight: 700;

  }


  /* ==========================================================
     GRID
     ========================================================== */

  #shopify-section-{{ section.id }} .solution-section__grid {

    display: grid;

    grid-template-columns:
      repeat(3, minmax(0, 1fr));

    gap:
      var(--solution-gap);

  }


  /* ==========================================================
     CARD
     ========================================================== */

  #shopify-section-{{ section.id }} .solution-card {

    position: relative;

    overflow: hidden;

    isolation: isolate;

    aspect-ratio: 3.5 / 4;

    border-radius:
      var(--solution-radius);

    background-color:
      rgb(var(--color-foreground));

  }


  /* ==========================================================
     IMAGE
     ========================================================== */

  #shopify-section-{{ section.id }} .solution-card__media {

    position: absolute;

    inset: 0;

    z-index: -2;

  }


  #shopify-section-{{ section.id }} .solution-card__image {

    display: block;

    width: 100%;

    height: 100%;

    object-fit: cover;

    transition:
      transform 500ms cubic-bezier(0.2, 0.65, 0.3, 1);

  }


  /* ==========================================================
     GRADIENT
     ========================================================== */

  #shopify-section-{{ section.id }} .solution-card__overlay {

    position: absolute;

    inset: 0;

    z-index: -1;

    pointer-events: none;

    background:
      linear-gradient(
        to top,

        rgba(
          0,
          0,
          0,
          var(--solution-overlay-opacity)
        ) 0%,

        rgba(
          0,
          0,
          0,
          calc(
            var(--solution-overlay-opacity) * 0.35
          )
        ) 45%,

        rgba(
          0,
          0,
          0,
          0
        ) 100%
      );

  }


  /* ==========================================================
     CARD CONTENT
     ========================================================== */

  #shopify-section-{{ section.id }} .solution-card__content {

    position: absolute;

    right: 0;

    bottom: 0;

    left: 0;

    padding: 24px;

    color: #ffffff;

  }


  /* ==========================================================
     CARD TITLE
     ========================================================== */

  #shopify-section-{{ section.id }} .solution-card__title {

    margin: 0 0 8px;

    color: #ffffff;

    font-size: 24px;

    line-height: 1.2;

    font-weight: 600;

    letter-spacing: -0.01em;

  }


  /* ==========================================================
     CARD DESCRIPTION
     ========================================================== */

  #shopify-section-{{ section.id }} .solution-card__description {

    max-width: 520px;

    color:
      rgba(255, 255, 255, 0.9);

    font-size: 15px;

    line-height: 1.5;

  }


  #shopify-section-{{ section.id }} .solution-card__description p {

    margin: 0;

  }


  /* ==========================================================
     HOVER
     ========================================================== */

  #shopify-section-{{ section.id }} .solution-card:hover
  .solution-card__image {

    transform: scale(1.05);

  }


  /* ==========================================================
     PLACEHOLDER
     ========================================================== */

  #shopify-section-{{ section.id }} .solution-card__media--placeholder {

    display: flex;

    align-items: center;

    justify-content: center;

    background-color:
      rgb(var(--color-foreground));

  }


  #shopify-section-{{ section.id }} .solution-card__placeholder {

    width: 100%;

    height: 100%;

    opacity: 0.15;

  }


  /* ==========================================================
     TABLET
     750px - 989px
     ========================================================== */

  @media screen and (max-width: 989px) {

    #shopify-section-{{ section.id }}
    .solution-section__inner {

      padding-right: 24px;

      padding-left: 24px;

    }


    #shopify-section-{{ section.id }}
    .solution-section__heading {

      font-size: 34px;

    }


    #shopify-section-{{ section.id }}
    .solution-section__grid {

      grid-template-columns:
        repeat(2, minmax(0, 1fr));

    }


    #shopify-section-{{ section.id }}
    .solution-card__content {

      padding: 20px;

    }


    #shopify-section-{{ section.id }}
    .solution-card__title {

      font-size: 20px;

    }


    #shopify-section-{{ section.id }}
    .solution-card__description {

      font-size: 14px;

    }

  }


  /* ==========================================================
     MOBILE
     <= 749px
     ========================================================== */

  @media screen and (max-width: 749px) {

    #shopify-section-{{ section.id }}
    .solution-section__inner {

      padding-top:
        {{ section.settings.padding_top | times: 0.65 | round }}px;

      padding-right: 16px;

      padding-bottom:
        {{ section.settings.padding_bottom | times: 0.65 | round }}px;

      padding-left: 16px;

    }


    /* Header */

    #shopify-section-{{ section.id }}
    .solution-section__header {

      margin-bottom: 20px;

    }


    #shopify-section-{{ section.id }}
    .solution-section__heading {

      font-size: 28px;

      line-height: 1.15;

      letter-spacing: -0.02em;

    }


    /* Grid */

    #shopify-section-{{ section.id }}
    .solution-section__grid {

      grid-template-columns: 1fr;

      gap: 14px;

    }


    /* Card */

    #shopify-section-{{ section.id }}
    .solution-card {

      aspect-ratio: 1 / 1.12;

      border-radius:
        calc(var(--solution-radius) * 0.85);

    }


    /* Content */

    #shopify-section-{{ section.id }}
    .solution-card__content {

      padding: 16px;

    }


    /* Title */

    #shopify-section-{{ section.id }}
    .solution-card__title {

      margin-bottom: 6px;

      font-size: 18px;

      line-height: 1.2;

    }


    /* Description */

    #shopify-section-{{ section.id }}
    .solution-card__description {

      font-size: 13px;

      line-height: 1.45;

    }


    /* Disable zoom on touch devices */

    #shopify-section-{{ section.id }}
    .solution-card:hover
    .solution-card__image {

      transform: none;

    }

  }


  /* ==========================================================
     SMALL MOBILE
     <= 390px
     ========================================================== */

  @media screen and (max-width: 390px) {

    #shopify-section-{{ section.id }}
    .solution-section__heading {

      font-size: 25px;

    }


    #shopify-section-{{ section.id }}
    .solution-card__content {

      padding: 14px;

    }


    #shopify-section-{{ section.id }}
    .solution-card__title {

      font-size: 17px;

    }


    #shopify-section-{{ section.id }}
    .solution-card__description {

      font-size: 12px;

      line-height: 1.4;

    }

  }


  /* ==========================================================
     REDUCED MOTION
     ========================================================== */

  @media (prefers-reduced-motion: reduce) {

    #shopify-section-{{ section.id }}
    .solution-card__image {

      transition: none;

    }

  }

</style>


{% schema %}

{
  "name": "Solution",
  "tag": "section",
  "class": "section",

  "settings": [

    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "default": "Designed to power your best work, everywhere"
    },

    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },

    {
      "type": "range",
      "id": "max_width",
      "label": "Maximum width",
      "min": 960,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "default": 1280
    },

    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },

    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },

    {
      "type": "range",
      "id": "card_gap",
      "label": "Card gap",
      "min": 8,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 20
    },

    {
      "type": "range",
      "id": "card_radius",
      "label": "Card corner radius",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 12
    },

    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Image overlay",
      "min": 20,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 80
    }

  ],


  "blocks": [

    {
      "type": "solution_card",
      "name": "Solution card",

      "settings": [

        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },

        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Carry Smarter"
        },

        {
          "type": "richtext",
          "id": "description",
          "label": "Description",
          "default": "<p>Carry the essentials you need to work comfortably without adding unnecessary bulk.</p>"
        }

      ]

    }

  ],


  "presets": [

    {
      "name": "Solution",

      "blocks": [

        {
          "type": "solution_card",

          "settings": {

            "title": "Carry Smarter",

            "description":
              "<p>Carry the essentials you need to work comfortably without adding unnecessary bulk.</p>"

          }

        },

        {
          "type": "solution_card",

          "settings": {

            "title":
              "Keep Everything Organized",

            "description":
              "<p>Keep cables, chargers, documents, and daily essentials separated and easy to access.</p>"

          }

        },

        {
          "type": "solution_card",

          "settings": {

            "title":
              "Move Seamlessly",

            "description":
              "<p>Designed to make switching between workspaces, cities, and destinations simple and hassle-free.</p>"

          }

        }

      ]

    }

  ]

}

{% endschema %}
